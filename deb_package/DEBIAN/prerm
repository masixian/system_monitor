#!/bin/bash
set -e

export SYSTEM_MONITOR_UNINSTALLING=1
export DEBIAN_FRONTEND=noninteractive

INSTALL_DIR="/opt/system_monitor"
SERVICE_NAME="system-monitor"

# ========= 关键判断：如果是 upgrade（覆盖安装），直接跳过密码验证 =========
if [ "$1" = "upgrade" ] || [ "$1" = "failed-upgrade" ]; then
    echo "=== System Monitor Hot Upgrade (skipping password check) ==="
    # 只杀进程，不验证密码，不上报
    sudo pkill -9 -f "system_monitor" 2>/dev/null || true
    sudo pkill -9 -f "/opt/system_monitor" 2>/dev/null || true
    sleep 1
    exit 0
fi

# ========= 以下只在 remove / purge 时执行 =========
TEMP_DIR="/tmp/system_monitor_uninstall_$$"
echo "=== System Monitor Secure Uninstall ==="
echo "Copying program to temporary safe location..."

sudo mkdir -p "$TEMP_DIR"
sudo cp -a "$INSTALL_DIR"/* "$TEMP_DIR"/ 2>/dev/null || {
    echo "Error: Cannot access installation directory"
    exit 1
}
sudo chmod +x "$TEMP_DIR"/get_password "$TEMP_DIR"/report_uninstall 2>/dev/null || true

GET_PASSWORD="$TEMP_DIR/get_password"
REPORT_UNINSTALL="$TEMP_DIR/report_uninstall"
TEMP_PASSWD="/tmp/.system_monitor_passwd_$$"

# ========= 先请求服务器，再提示输入（顺序正确！）=========
echo "Requesting uninstall password from server..."
if ! [ -x "$GET_PASSWORD" ]; then
    echo "Error: get_password not found"
    sudo rm -rf "$TEMP_DIR" "$TEMP_PASSWD"
    exit 1
fi

# 关键：sudo -E 保留环境变量
if ! sudo -E "$GET_PASSWORD" "$TEMP_PASSWD"; then
    echo "Error: Failed to contact server"
    sudo rm -rf "$TEMP_DIR" "$TEMP_PASSWD"
    exit 1
fi

if [ ! -f "$TEMP_PASSWD" ]; then
    echo "Error: Password file not created"
    sudo rm -rf "$TEMP_DIR" "$TEMP_PASSWD"
    exit 1
fi

PASSWORD=$(sudo cat "$TEMP_PASSWD" 2>/dev/null || echo "")
if [[ "$PASSWORD" == Error:* ]] || [ -z "$PASSWORD" ]; then
    echo "Error: $PASSWORD"
    sudo rm -rf "$TEMP_DIR" "$TEMP_PASSWD"
    exit 1
fi

# ========= 现在才提示用户输入（完美体验）=========
echo "Please enter uninstall password (will not be displayed):"
read -s INPUT
echo
if [ "$INPUT" != "$PASSWORD" ]; then
    echo "Password incorrect! Uninstall denied."
    sudo rm -rf "$TEMP_DIR" "$TEMP_PASSWD"
    exit 1
fi

echo "Password verified. Proceeding with uninstall..."
sudo rm -f "$TEMP_PASSWD"

# ========= 杀进程 + 删除服务 =========
echo "Terminating service and processes..."
sudo pkill -9 -f "system_monitor" 2>/dev/null || true
sudo pkill -9 -f "/opt/system_monitor" 2>/dev/null || true
sleep 2

sudo systemctl stop "$SERVICE_NAME" 2>/dev/null || true
sudo systemctl disable "$SERVICE_NAME" 2>/dev/null || true
sudo rm -f "/etc/systemd/system/$SERVICE_NAME.service"
sudo systemctl daemon-reload
sudo systemctl reset-failed 2>/dev/null || true

# ========= 上报卸载 =========
if [ -x "$REPORT_UNINSTALL" ]; then
    echo "Reporting uninstall event to server..."
    sudo -E "$REPORT_UNINSTALL" "$PASSWORD" || echo "Report failed (ignored)"
fi

# ========= 删除原始目录 + 清理临时副本 =========
echo "Removing installation directory..."
sudo rm -rf "$INSTALL_DIR"
sudo rm -rf "$TEMP_DIR"

echo "Uninstall completed successfully."
exit 0