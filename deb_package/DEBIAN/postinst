#!/bin/bash
set -e

# ========= 卸载模式直接退出 =========
[ "$SYSTEM_MONITOR_UNINSTALLING" = "1" ] && exit 0

# 防止 prerm/postrm 触发
[ -n "$DPKG_MAINTSCRIPT_NAME" ] && [ "$DPKG_MAINTSCRIPT_NAME" != "postinst" ] && exit 0

INSTALL_DIR="/opt/system_monitor"
LOG_DIR="/var/log/system_monitor"
RUNTIME_TMP="$INSTALL_DIR/tmp"
LIB_DIR="$INSTALL_DIR/lib"
SERVICE_NAME="system-monitor"

# ========= 1. 永久关闭 Kysec（只执行一次）=========
if ! grep -q 'GRUB_CMDLINE_LINUX_SECURITY="security="' /etc/default/grub 2>/dev/null; then
    echo "Permanently disabling Kysec security popups..."
    sudo cp /etc/default/grub /etc/default/grub.bak
    sudo sed -i '/GRUB_CMDLINE_LINUX_DEFAULT=/ s/security=kysec//g' /etc/default/grub
    sudo sed -i '/GRUB_CMDLINE_LINUX=/ s/security=kysec//g' /etc/default/grub
    echo 'GRUB_CMDLINE_LINUX_SECURITY="security="' | sudo tee -a /etc/default/grub > /dev/null
    sudo update-grub
    echo "Kysec permanently disabled. Reboot once to take effect."
fi

# ========= 2. 强制杀掉旧进程（热覆盖核心）=========
echo "Terminating old processes for hot upgrade..."
sudo pkill -9 -f "system_monitor" 2>/dev/null || true
sudo pkill -9 -f "/opt/system_monitor" 2>/dev/null || true
sleep 2

# ========= 3. 创建目录 =========
mkdir -p "$INSTALL_DIR" "$LOG_DIR" "$RUNTIME_TMP" "$LIB_DIR"
chown root:root "$INSTALL_DIR" "$LOG_DIR" "$RUNTIME_TMP" "$LIB_DIR"
chmod 700 "$INSTALL_DIR" "$LOG_DIR" "$RUNTIME_TMP" "$LIB_DIR"

# ========= 4. 复制必要库（防止依赖丢失）=========
for lib in libz.so.1 libcrypto.so.1.1 libbz2.so.1.0 libssl.so.1.1 libstdc++.so.6; do
    find /usr/lib* -name "$lib*" -exec cp -f {} "$LIB_DIR/" \; 2>/dev/null || true
done
chmod 755 "$LIB_DIR"/* 2>/dev/null || true

# ========= 5. RocketMQ 日志目录 =========
sudo mkdir -p /tmp/logs/rocketmq-cpp
sudo chmod 777 /tmp/logs/rocketmq-cpp

# ========= 6. systemd 服务（支持热重启）=========
cat > "/etc/systemd/system/$SERVICE_NAME.service" << 'EOL'
[Unit]
Description=System Monitor Service
After=network.target

[Service]
ExecStart=/opt/system_monitor/system_monitor
WorkingDirectory=/opt/system_monitor
Environment="LD_LIBRARY_PATH=/opt/system_monitor/lib:/usr/lib/x86_64-linux-gnu"
Environment="PYINSTALLER_TMP=/opt/system_monitor/tmp"
Restart=always
RestartSec=3
User=root
KillMode=process
RuntimeDirectory=system_monitor_tmp
RuntimeDirectoryMode=0700

[Install]
WantedBy=multi-user.target
EOL

systemctl daemon-reload
systemctl enable "$SERVICE_NAME" >/dev/null 2>&1

# ========= 7. 启动新进程（确保只有一个）=========
if systemctl is-active --quiet "$SERVICE_NAME"; then
    systemctl restart "$SERVICE_NAME"
    echo "Service hot-restarted successfully."
else
    systemctl start "$SERVICE_NAME"
    echo "Service started."
fi

echo "System Monitor successfully installed/upgraded"
echo "No popups · Hot deploy · Single process · Ready"
exit 0